<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.homebackexit"
       name="Home Back Exit"
       version="0.1.0"
       provider-name="waniki239">

    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>

    <extension point="xbmc.python.script"
               library="addon.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Install a Home screen Back button keymap.</summary>

        <description lang="en_GB">Installs a keymap that opens the Shutdown Menu when the Back button is pressed on Kodi's Home screen.</description>

        <platform>all</platform>

        <license>MIT</license>

        <source>https://github.com/waniki239/script.homebackexit</source>

        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.png</fanart>
        </assets>

        <news>
            Initial release.
        </news>
    </extension>

</addon>