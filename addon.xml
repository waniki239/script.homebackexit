<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.homebackexit"
       name="Home Back Exit"
       version="0.1.0"
       provider-name="waniki239">

    <extension point="xbmc.keymap">
        <keymap>keymaps/homeback.xml</keymap>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">
            Opens the shutdown menu when Back is pressed on the Home screen.
        </summary>

        <description lang="en_GB">
            A lightweight Kodi addon that remaps the Back button on the Home screen to open the shutdown menu, while leaving the Back button unchanged everywhere else.
        </description>

        <platform>all</platform>

        <license>MIT</license>

        <source>https://github.com/waniki239/service.homebackexit</source>

        <news>
            Initial release.
        </news>
    </extension>

</addon>